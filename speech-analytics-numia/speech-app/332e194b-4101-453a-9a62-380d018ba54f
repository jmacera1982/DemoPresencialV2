      <div className="comp-list">
        {items.map((it, i) => (
          <div className={"comp-row" + (onDrill ? " drill" : "")} key={i} onClick={onDrill ? () => onDrill(it.name) : null} style={{ cursor: onDrill ? "pointer" : "default" }}>
            <span className="lb-rank">#{i + 1}</span>
            <span className="comp-name">{it.name}</span>
            <span className="comp-count">{it.right}</span>
          </div>
        ))}
      </div>
